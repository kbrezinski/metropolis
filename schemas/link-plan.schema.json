{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kbrezinski/ot-detection-systems/blob/main/schemas/link-plan.schema.json",
  "title": "OT testbed link plan",
  "description": "Machine-readable cabling between testbed nodes. Interface names are the ones the router and device models configure; switch port roles are logical labels, because literal GNS3 port numbers are only known after cabling.",
  "type": "object",
  "required": ["schema_version", "testbed_id", "links"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "testbed_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]*$"
    },
    "description": { "type": "string" },
    "links": {
      "type": "array",
      "items": { "$ref": "#/$defs/link" },
      "minItems": 1
    }
  },
  "$defs": {
    "endpoint": {
      "type": "object",
      "required": ["node"],
      "properties": {
        "node": { "type": "string", "minLength": 1 },
        "interface": {
          "type": "string",
          "pattern": "^(?:eth[0-9]+(?:\\.vif[0-9]+)?|vti[0-9]+)$",
          "description": "Ethernet interface, optional 802.1Q subinterface, or logical IPsec VTI"
        },
        "port_role": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$",
          "description": "Logical switch port label such as router-uplink; not a GNS3 port number"
        },
        "inventoried": {
          "type": "boolean",
          "default": true,
          "description": "False when the node is specified but not yet present in the device inventory"
        },
        "notes": { "type": "string" }
      },
      "additionalProperties": false
    },
    "link": {
      "type": "object",
      "required": ["id", "kind", "description", "endpoints"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9_-]*$" },
        "kind": {
          "enum": ["trunk", "access", "transit", "underlay", "overlay"],
          "description": "Physical cabling or a logical overlay. Overlay links configure router VTIs and are not GNS3 cables or capture points."
        },
        "description": { "type": "string", "minLength": 1 },
        "network_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]*$",
          "description": "Network this link carries, as identified in the address plan"
        },
        "cidr": {
          "type": "string",
          "pattern": "^(?:[0-9]{1,3}\\.){3}[0-9]{1,3}/(?:[0-9]|[12][0-9]|3[0-2])$"
        },
        "vlans": {
          "type": "array",
          "items": { "type": "integer", "minimum": 1, "maximum": 4094 },
          "uniqueItems": true
        },
        "endpoints": {
          "type": "array",
          "items": { "$ref": "#/$defs/endpoint" },
          "minItems": 2,
          "maxItems": 2
        },
        "status": {
          "enum": ["planned", "configured", "verified"],
          "default": "planned",
          "description": "planned means specified only; no cabling or configuration has been checked"
        },
        "notes": { "type": "string" }
      },
      "allOf": [
        {
          "if": { "properties": { "kind": { "const": "overlay" } }, "required": ["kind"] },
          "then": {
            "required": ["network_id", "cidr"],
            "properties": {
              "vlans": { "maxItems": 0 },
              "endpoints": { "items": { "required": ["interface"], "properties": { "interface": { "pattern": "^vti[0-9]+$" } }, "not": { "required": ["port_role"] } } }
            }
          },
          "else": {
            "properties": { "endpoints": { "items": { "properties": { "interface": { "not": { "pattern": "^vti" } } } } } }
          }
        }
      ],
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
