{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://metropolis.local/schemas/experiment-run.schema.json",
  "title": "Metropolis experiment run manifest",
  "type": "object",
  "required": ["schema_version", "run_id", "project_id", "started_at_utc", "status", "logs", "failures"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "run_id": {"type": "string", "minLength": 1},
    "project_id": {"type": "string", "minLength": 1},
    "project_name": {"type": "string"},
    "testbed_id": {"type": "string"},
    "dataset_version": {"type": "string"},
    "dataset_path": {"type": "string"},
    "topology_document_sha256": {"type": "object", "additionalProperties": {"type": "string"}},
    "firewall_policy_sha256": {"type": "string"},
    "firewall": {
      "type": "object",
      "required": ["policy_sha256", "attack_exceptions", "configuration_requested", "restored_baseline", "failures"],
      "properties": {
        "policy_sha256": {"type": "string"},
        "configuration_requested": {"type": "boolean"},
        "attack_exceptions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "source", "destination", "protocol", "port", "routers"],
            "properties": {
              "id": {"type": "string"},
              "source": {"type": "string"},
              "destination": {"type": "string"},
              "protocol": {"enum": ["tcp", "udp", "icmp"]},
              "port": {"type": ["integer", "null"]},
              "routers": {"type": "array", "items": {"type": "string"}}
            },
            "additionalProperties": false
          }
        },
        "restored_baseline": {"type": "boolean"},
        "failures": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "started_at_utc": {"type": "string", "format": "date-time"},
    "stopped_at_utc": {"type": "string", "format": "date-time"},
    "status": {"enum": ["running", "complete", "failed", "interrupted"]},
    "timeline_path": {"type": "string"},
    "attack_events_path": {"type": "string"},
    "mqtt_acl": {
      "type": "object",
      "required": ["scenario_id", "status", "source", "target", "broker", "scada", "attempts", "broker_evidence", "subscriber_evidence", "capture_links", "failures"],
      "properties": {
        "scenario_id": {"const": "mqtt.acl_cross_cell.v1"},
        "status": {"enum": ["planned", "running", "pending_capture", "complete", "failed", "skipped"]},
        "source": {"type": "string"},
        "target": {"type": "string"},
        "broker": {"type": "string"},
        "scada": {"type": "string"},
        "started_at_utc": {"type": "string", "format": "date-time"},
        "stopped_at_utc": {"type": "string", "format": "date-time"},
        "attempts": {"type": "array", "items": {"type": "object"}},
        "broker_evidence": {"type": "object", "additionalProperties": {"type": "boolean"}},
        "subscriber_evidence": {"type": "object", "additionalProperties": {"type": "boolean"}},
        "downstream_delivery": {"enum": ["unverified", "blocked_by_broker"]},
        "capture_links": {"type": "object", "additionalProperties": {"type": "array", "items": {"type": "string"}}},
        "capture_selected": {"type": "boolean"},
        "capture_started": {"type": "boolean"},
        "capture_saved": {"type": "boolean"},
        "failures": {"$ref": "#/$defs/metricFailures"}
      },
      "additionalProperties": true
    },
    "selected_capture_links": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "captures": {"type": "array", "items": {"type": "string"}},
    "resource_baseline": {
      "type": "object",
      "required": ["path", "sha256", "mode", "status", "nodes", "unsupported", "failures"],
      "properties": {
        "path": {"type": "string"},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "mode": {"enum": ["check", "apply"]},
        "status": {"enum": ["matched", "drift", "failed"]},
        "checked_at_utc": {"type": "string", "format": "date-time"},
        "nodes": {"type": "object", "additionalProperties": {"type": "object"}},
        "unsupported": {"type": "array", "items": {"type": "object"}},
        "failures": {"$ref": "#/$defs/metricFailures"}
      },
      "additionalProperties": false
    },
    "profiles": {
      "type": "object",
      "required": ["enabled"],
      "properties": {
        "enabled": {"type": "boolean"},
        "name": {"type": "string"},
        "path": {"type": "string"},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "state_path": {"type": "string"},
        "status": {"enum": ["planned", "applied", "restored", "failed"]},
        "configuration_verified": {"type": "boolean"},
        "restored": {"type": "boolean"},
        "devices": {"type": "array", "items": {"type": "object"}},
        "links": {"type": "array", "items": {"type": "object"}},
        "failures": {"$ref": "#/$defs/metricFailures"},
        "observations": {"type": "object"}
      },
      "additionalProperties": false
    },
    "rdp": {
      "type": "object",
      "required": ["status", "sessions", "udp_modes", "failures"],
      "properties": {
        "status": {"enum": ["planned", "running", "complete", "failed", "skipped"]},
        "started_at_utc": {"type": "string", "format": "date-time"},
        "stopped_at_utc": {"type": "string", "format": "date-time"},
        "sessions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["source", "source_address", "destination", "destination_address", "status"],
            "properties": {
              "source": {"type": "string"},
              "source_address": {"type": "string"},
              "destination": {"type": "string"},
              "destination_address": {"type": "string"},
              "status": {"enum": ["planned", "running", "complete", "failed", "skipped"]},
              "capture_links": {
                "type": "object",
                "required": ["source", "routed", "destination"],
                "properties": {
                  "source": {"type": "array", "items": {"type": "string"}},
                  "routed": {"type": "array", "items": {"type": "string"}},
                  "destination": {"type": "array", "items": {"type": "string"}}
                },
                "additionalProperties": false
              },
              "capture_path_status": {"enum": ["resolved", "missing", "ambiguous"]},
              "capture_selected": {"type": "boolean"},
              "capture_started": {"type": "boolean"},
              "capture_saved": {"type": "boolean"},
              "started_at_utc": {"type": "string", "format": "date-time"},
              "stopped_at_utc": {"type": "string", "format": "date-time"},
              "tcp_success": {"type": "boolean"},
              "udp_sent": {"type": "integer", "minimum": 0},
              "udp_received": {"type": "integer", "minimum": 0},
              "udp_response_bytes": {"type": "integer", "minimum": 0},
              "reason": {"type": "string"}
            },
            "additionalProperties": false
          }
        },
        "udp_modes": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": ["status"],
            "properties": {
              "status": {"enum": ["planned", "applied", "benign_verified", "restored", "failed", "skipped"]},
              "requested_mode": {"enum": ["benign", "amplify"]},
              "started_at_utc": {"type": "string", "format": "date-time"},
              "stopped_at_utc": {"type": "string", "format": "date-time"},
              "lease_seconds": {"type": "integer", "minimum": 1}
            },
            "additionalProperties": false
          }
        },
        "readiness": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": ["tcp_ready", "udp_ready", "checked_at_utc"],
            "properties": {
              "tcp_ready": {"type": "boolean"},
              "udp_ready": {"type": "boolean"},
              "checked_at_utc": {"type": "string", "format": "date-time"}
            },
            "additionalProperties": false
          }
        },
        "failures": {"$ref": "#/$defs/metricFailures"}
      },
      "additionalProperties": false
    },
    "metrics": {
      "type": "object",
      "required": ["enabled", "status", "sample_interval_seconds"],
      "properties": {
        "enabled": {"type": "boolean"},
        "status": {"enum": ["disabled", "running", "complete", "failed"]},
        "sample_interval_seconds": {"type": "number", "exclusiveMinimum": 0},
        "resource": {
          "type": "object",
          "required": ["status", "container_samples_path", "compute_samples_path", "sources", "computes", "failures"],
          "properties": {
            "status": {"enum": ["running", "complete", "failed"]},
            "started_at_utc": {"type": "string", "format": "date-time"},
            "stopped_at_utc": {"type": "string", "format": "date-time"},
            "container_samples_path": {"type": "string"},
            "compute_samples_path": {"type": "string"},
            "sources": {"type": "object", "additionalProperties": {"$ref": "#/$defs/metricSource"}},
            "computes": {"type": "object", "additionalProperties": {"$ref": "#/$defs/metricCompute"}},
            "failures": {"$ref": "#/$defs/metricFailures"}
          },
          "additionalProperties": false
        },
        "traffic": {
          "type": "object",
          "required": ["csv_path", "bin_seconds", "links", "failures"],
          "properties": {
            "csv_path": {"type": "string"},
            "bin_seconds": {"const": 1},
            "links": {"type": "object", "additionalProperties": {"type": "object"}},
            "failures": {"$ref": "#/$defs/metricFailures"}
          },
          "additionalProperties": false
        },
        "summary_path": {"type": "string"},
        "charts": {"type": "array", "items": {"type": "string"}},
        "failures": {"$ref": "#/$defs/metricFailures"}
      },
      "allOf": [
        {
          "if": {"properties": {"enabled": {"const": false}}},
          "then": {"properties": {"status": {"const": "disabled"}}},
          "else": {"properties": {"status": {"enum": ["running", "complete", "failed"]}}}
        }
      ],
      "additionalProperties": false
    },
    "capture": {
      "type": "object",
      "required": ["manifest_path", "links", "unavailable_declared_links", "failures"],
      "properties": {
        "manifest_path": {"type": "string"},
        "links": {"type": "object", "additionalProperties": {"type": "object"}},
        "unavailable_declared_links": {"type": "object", "additionalProperties": {"type": "object"}},
        "failures": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "logs": {
      "type": "object",
      "required": ["normalized_path", "sources"],
      "properties": {
        "normalized_path": {"type": "string"},
        "intentionally_silent_sources": {"type": "array", "items": {"type": "string"}},
        "sources": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": ["node_id", "compute_id", "container_id", "raw_path", "lines", "complete"],
            "properties": {
              "node_id": {"type": "string"},
              "compute_id": {"type": "string"},
              "container_id": {"type": "string"},
              "raw_path": {"type": "string"},
              "lines": {"type": "integer", "minimum": 0},
              "complete": {"type": "boolean"}
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "syslog": {
      "type": "object",
      "required": ["path", "expected_sources", "sources", "missing_sources"],
      "properties": {
        "path": {"type": "string"},
        "expected_sources": {"type": "array", "items": {"type": "string"}},
        "source_kinds": {"type": "object", "additionalProperties": {"enum": ["router", "switch"]}},
        "sources": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 1}},
        "transports": {"type": "object", "additionalProperties": {"enum": ["udp_relay", "docker_stdout_bridge", "unknown"]}},
        "missing_sources": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "failures": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["source", "reason"],
        "properties": {
          "source": {"type": "string"},
          "reason": {"type": "string"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "metricSource": {
      "type": "object",
      "required": ["name", "node_id", "node_type", "compute_id", "container_ids", "samples", "status"],
      "properties": {
        "name": {"type": "string"},
        "node_id": {"type": "string"},
        "node_type": {"type": "string"},
        "compute_id": {"type": "string"},
        "container_ids": {"type": "array", "items": {"type": "string"}},
        "samples": {"type": "integer", "minimum": 0},
        "status": {"enum": ["pending", "collecting", "complete", "unavailable", "unsupported"]},
        "reason": {"type": "string"}
      },
      "additionalProperties": false
    },
    "metricCompute": {
      "type": "object",
      "required": ["name", "compute_id", "samples", "status"],
      "properties": {
        "name": {"type": "string"},
        "compute_id": {"type": "string"},
        "samples": {"type": "integer", "minimum": 0},
        "status": {"enum": ["pending", "collecting", "complete", "unavailable"]},
        "reason": {"type": "string"}
      },
      "additionalProperties": false
    },
    "metricFailures": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["source", "reason"],
        "properties": {
          "source": {"type": "string"},
          "reason": {"type": "string"}
        },
        "additionalProperties": false
      }
    }
  }
}
