{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://metropolis.local/schemas/firewall-policy.schema.json",
  "title": "Metropolis routed network firewall policy",
  "type": "object",
  "required": ["schema_version", "testbed_id", "flows"],
  "properties": {
    "schema_version": {"const": "2.0"},
    "testbed_id": {"type": "string", "minLength": 1},
    "flows": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "source", "destination", "protocol"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "source": {"$ref": "#/$defs/selectors"},
          "destination": {"$ref": "#/$defs/selectors"},
          "protocol": {"enum": ["tcp", "udp", "icmp"]},
          "port": {"type": "integer", "minimum": 1, "maximum": 65535}
        },
        "additionalProperties": false
      }
    }
  },
  "$defs": {
    "selectors": {
      "oneOf": [
        {"type": "string", "minLength": 1},
        {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      ]
    }
  },
  "additionalProperties": false
}
