{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kbrezinski/ot-detection-systems/blob/main/schemas/device-inventory.schema.json",
  "title": "OT testbed device inventory",
  "description": "Reusable structure for the Docker device nodes of one testbed: the end devices created from the reusable models in the device library. Routers and switches are inventoried separately in the infrastructure file.",
  "type": "object",
  "required": ["schema_version", "testbed_id", "devices"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "testbed_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]*$"
    },
    "description": { "type": "string" },
    "devices": {
      "type": "array",
      "items": { "$ref": "#/$defs/device" },
      "minItems": 1
    }
  },
  "$defs": {
    "cidr": {
      "type": "string",
      "pattern": "^(?:[0-9]{1,3}\\.){3}[0-9]{1,3}/(?:[0-9]|[12][0-9]|3[0-2])$"
    },
    "device": {
      "type": "object",
      "required": [
        "name",
        "model",
        "image",
        "site",
        "subnet",
        "address",
        "protocols"
      ],
      "properties": {
        "name": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]*$" },
        "model": {
          "type": "string",
          "minLength": 1,
          "description": "Repository-relative path to the reusable device model"
        },
        "image": { "type": "string", "minLength": 1 },
        "site": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "subnet": { "$ref": "#/$defs/cidr" },
        "address": { "$ref": "#/$defs/cidr" },
        "gateway": { "type": "string", "format": "ipv4" },
        "protocols": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
          "uniqueItems": true
        },
        "environment": {
          "type": "object",
          "description": "Values copied into the node's GNS3 Docker environment",
          "propertyNames": { "pattern": "^[A-Z][A-Z0-9_]*$" },
          "additionalProperties": { "type": "string" }
        },
        "notes": { "type": "string" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
