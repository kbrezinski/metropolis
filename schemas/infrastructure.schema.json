{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kbrezinski/ot-detection-systems/blob/main/schemas/infrastructure.schema.json",
  "title": "OT testbed infrastructure inventory",
  "description": "Reusable structure for the routers, switches, and unmodelled access segments of one testbed. These are not Docker nodes, so they are inventoried separately from the device instances.",
  "type": "object",
  "required": ["schema_version", "testbed_id", "routers", "switches", "segments"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "testbed_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]*$"
    },
    "description": { "type": "string" },
    "routers": {
      "type": "array",
      "items": { "$ref": "#/$defs/router" }
    },
    "switches": {
      "type": "array",
      "items": { "$ref": "#/$defs/switch" }
    },
    "segments": {
      "type": "array",
      "items": { "$ref": "#/$defs/segment" }
    }
  },
  "$defs": {
    "name": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
    },
    "router": {
      "type": "object",
      "required": ["name", "kind", "role", "config", "interfaces"],
      "properties": {
        "name": { "$ref": "#/$defs/name" },
        "kind": { "enum": ["vyos"] },
        "role": { "type": "string", "minLength": 1 },
        "config": {
          "type": "string",
          "minLength": 1,
          "description": "Repository-relative path to the router configuration script"
        },
        "notes": { "type": "string" },
        "interfaces": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/interface" }
        }
      },
      "additionalProperties": false
    },
    "interface": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "pattern": "^eth[0-9]+$" },
        "kind": { "enum": ["trunk"] },
        "cidr": {
          "type": "string",
          "pattern": "^(?:[0-9]{1,3}\\.){3}[0-9]{1,3}/(?:[0-9]|[12][0-9]|3[0-2])$"
        },
        "vlans": {
          "type": "array",
          "items": { "type": "integer", "minimum": 1, "maximum": 4094 },
          "uniqueItems": true
        },
        "description": { "type": "string" }
      },
      "additionalProperties": false
    },
    "switch": {
      "type": "object",
      "required": ["name", "kind", "role", "spec", "attachment_points"],
      "properties": {
        "name": { "$ref": "#/$defs/name" },
        "kind": { "enum": ["ethernet-switch"] },
        "role": { "type": "string", "minLength": 1 },
        "spec": {
          "type": "string",
          "minLength": 1,
          "description": "Repository-relative path to the switch specification document"
        },
        "notes": { "type": "string" },
        "attachment_points": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "segment": {
      "type": "object",
      "required": ["name", "role", "network_id"],
      "properties": {
        "name": { "$ref": "#/$defs/name" },
        "role": { "type": "string", "minLength": 1 },
        "network_id": { "type": "string", "pattern": "^[a-z][a-z0-9_-]*$" },
        "notes": { "type": "string" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
